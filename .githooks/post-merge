#!/bin/sh
# Hook post-merge — deteccion del implante "A8-3424-1" / campana EtherHiding.
# Se dispara despues de un 'git pull' (fetch + merge), incluyendo
# fast-forward.
#
# IMPORTANTE: a diferencia de pre-commit, esto NO puede bloquear -- el pull
# ya sucedio para cuando este hook corre. Es alerta inmediata, no
# prevencion: revisa los hallazgos antes de confiar en o ejecutar lo que se
# acaba de descargar (build, npm install, abrir en el editor...).
#
# Mismas firmas y logica que .githooks/pre-commit, aplicadas sobre todo el
# arbol versionado en vez de solo lo staged.

RED='\033[0;31m'
NC='\033[0m'

LITERAL_PATTERN="global.i[ 	]*=[ 	]*['\"]A8-|global\['!'\]=|global\['e'\]='app-[a-z]+-eval'|_\\\$_1e42|windowsHide.{0,80}detached|detached.{0,80}windowsHide|ETH_RPC_URL|eth\.blockscout\.com|ethereum-rpc\.publicnode\.com|eth\.drpc\.org|1rpc\.io/eth|blastapi\.io|api\.trongrid\.io|fullnode\.mainnet\.aptoslabs\.com|bsc-dataseed\.binance\.org|bsc-rpc\.publicnode\.com|SvcHostUpdate|97icr5|main\.inz\.cjs|q4FZkxX"
RISKY_CONFIG_RE='(^|/)(vite\.config\.(js|ts|mjs|cjs)|webpack\.(config|mix)\.js|postcss\.config\.(js|cjs|mjs)|tailwind\.config\.(js|cjs|mjs)|babel\.config\.(js|cjs)|\.babelrc.*|next\.config\.(js|mjs)|rollup\.config\.js|jest\.config\.(js|cjs)|eslint\.config\.(js|cjs|mjs|ts))$'
MAXLEN=400
FOUND=0

# --- un solo grep sobre todos los archivos en vez de uno por archivo: con
#     cientos de archivos, invocar grep por archivo tarda decenas de segundos
#     en Windows (cada proceso nuevo tiene overhead alto) ---
SCAN_LIST=$(git ls-files | while IFS= read -r f; do
    case "$f" in
        .githooks/*|.github/workflows/security-*.yml|*.QUARANTINED) continue ;;
    esac
    [ -f "$f" ] && printf '%s\n' "$f"
done)

if [ -n "$SCAN_LIST" ]; then
    MATCHES=$(printf '%s\n' "$SCAN_LIST" | xargs grep -lEa "$LITERAL_PATTERN" 2>/dev/null)
    if [ -n "$MATCHES" ]; then
        for m in $MATCHES; do
            printf "${RED}✖ ALERTA — firma conocida del implante en: %s${NC}\n" "$m"
        done
        FOUND=1
    fi

    RISKY_MATCHES=$(printf '%s\n' "$SCAN_LIST" | grep -E "$RISKY_CONFIG_RE")
    if [ -n "$RISKY_MATCHES" ]; then
        for f in $RISKY_MATCHES; do
            longest=$(awk '{ print length }' "$f" 2>/dev/null | sort -rn | head -1)
            if [ -n "$longest" ] && [ "$longest" -gt "$MAXLEN" ]; then
                printf "${RED}✖ ALERTA — %s tiene una linea de %s bytes (limite %s). Patron identico al de infecciones previas.${NC}\n" "$f" "$longest" "$MAXLEN"
                FOUND=1
            fi
        done
    fi
fi

if [ -f ".vscode/tasks.json" ] && grep -q "folderOpen" ".vscode/tasks.json" 2>/dev/null; then
    printf "${RED}✖ ALERTA — .vscode/tasks.json define una tarea con runOn:folderOpen (auto-ejecucion al abrir el proyecto).${NC}\n"
    FOUND=1
fi

# --- identidad de committer conocida del mecanismo de injerto (no depende de
#     ninguna firma de contenido: el autor suele venir falsificado con la
#     identidad de un colaborador legitimo, pero el committer real ha
#     aparecido siempre como "yugin0120" en todos los casos confirmados) ---
BAD_COMMITTER="yugin0120"
COMMIT_RANGE=""
if git rev-parse --verify -q ORIG_HEAD >/dev/null 2>&1; then
    COMMIT_RANGE="ORIG_HEAD..HEAD"
fi
if [ -n "$COMMIT_RANGE" ] && git log "$COMMIT_RANGE" --format='%cn' 2>/dev/null | grep -qx "$BAD_COMMITTER"; then
    printf "${RED}✖ ALERTA — commit(s) con identidad de committer '%s', asociada al mecanismo de reinfeccion conocido:${NC}\n" "$BAD_COMMITTER"
    git log "$COMMIT_RANGE" --format='  %h  autor: %an <%ae>  committer: %cn <%ce>  %s' 2>/dev/null | grep -F "$BAD_COMMITTER"
    FOUND=1
fi

if [ "$FOUND" -eq 1 ]; then
    echo ""
    echo "############################################################"
    echo "# ALERTA: revisa los hallazgos de arriba antes de ejecutar/  #"
    echo "# instalar nada de lo que se acaba de descargar con este     #"
    echo "# pull.                                                       #"
    echo "############################################################"
fi

exit 0
